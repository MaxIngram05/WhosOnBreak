# Copy to .env for local development. .env is git-ignored; this file is not,
# so nothing real goes in here.

# Where the data lives.
#   pglite              in-memory Postgres, wiped on exit, nothing to install
#   pglite:./.data      the same, kept on disk between runs
#   postgresql://...    Neon (use a branch, not production, from a laptop)
DATABASE_URL=pglite

# Signs our access tokens. At least 32 characters of randomness, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# OAuth client ids allowed to sign in, comma-separated. The Android client id
# from Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_CLIENT_IDS=

# Optional.
# PORT=8787
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=60

# Set to 1 to load demo users, a group and schedules on startup, and print an
# access token for each.
# SEED=1

# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_ variables reach the app,
# and they are baked into the bundle -- never put a secret here.

# Where the API runs. On the Android emulator the default, http://10.0.2.2:8787,
# already points at your computer. On a real phone use your computer's LAN
# address (ipconfig -> IPv4 Address), with the phone on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8787
